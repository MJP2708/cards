// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// The tenant. Every row of inventory, sales and configuration belongs to exactly
/// one Store, and no query may cross that line — see `src/lib/db/scoped.ts`, which
/// enforces it centrally rather than trusting ~336 call sites to remember a filter.
///
/// Signing up creates a Store and makes the signer-up its OWNER, so a brand new
/// account starts with its own empty inventory. Owners can then add members.
model Store {
  id        String   @id @default(cuid())
  /// Shown in the app header, the browser tab and on sales report PDFs.
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  cards         Card[]
  categories    Category[]
  sales         Sale[]
  bundles       Bundle[]
  priceComps     PriceComp[]
  priceSnapshots PriceSnapshot[]
  filterPresets  FilterPreset[]
  importBatches ImportBatch[]
  importMappings ImportMapping[]
  settings      Settings?
}

model Card {
  id          String    @id @default(cuid())
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    String // "NBA", "Football", "Pokemon", "TCG-MTG", "TCG-OnePiece", etc.
  name        String // player name (sports) or card name (Pokemon/TCG) — used for search
  series      String // set/expansion/series name
  year        Int?
  cardNumber  String?
  cardType    String? // base/rookie/insert/auto/relic/parallel (sports) or Pokemon/Trainer/Energy/Creature/Spell (TCG)
  rarity      String? // e.g. "/99", "1/1", "Holo Rare", "Secret Rare"
  grade       String? // e.g. "PSA 10"
  attributes  Json? // category-specific extra fields, e.g. { "team": "Lakers", "position": "PG" }
  costBasis   Float
  askingPrice Float
  quantity    Int       @default(1)
  status      String    @default("In Stock") // In Stock, Sold, Reserved, On Hold
  photoFront  String?
  photoBack   String?
  // True when photoFront was pulled from a marketplace listing rather than
  // photographed in hand. A stock image is a reference for identification only —
  // condition and centring are exactly what it cannot be trusted for — so the UI
  // labels it, and nothing may overwrite a photo the seller took themselves.
  photoIsStock Boolean  @default(false)
  // Unique per store, not globally: two stores printing their own labels must be
  // able to use the same short code without colliding.
  qrCode      String?
  packed      Boolean   @default(false) // pre-event staging checklist
  isHot       Boolean   @default(false) // manual "hot card" flag
  hotNote     String?
  researchNotes String? // manual set/card background notes for the Fact Sheet panel
  liveStats        Json? // cached API-Sports player stats snapshot
  liveStatsFetchedAt DateTime? // rate limits are tight (100 req/day free tier) — cache, don't poll
  dateAdded   DateTime  @default(now())
  dateSold    DateTime?
  soldPrice   Float?
  buyerNote   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Worksheet-import provenance. enrichmentStatus tracks the background pass that
  // runs after a batch commits: pending -> enriched | skipped | failed.
  importBatchId    String?
  importBatch      ImportBatch? @relation(fields: [importBatchId], references: [id])
  enrichmentStatus String?
  needsReview      Boolean      @default(false)
  reviewReason     String?

  // Post-commit correctness audit — a separate question from enrichment, which only
  // asks "did the stats lookup succeed?". Verification asks "is what this row says
  // actually true?", and runs against real inventory rather than staged rows.
  //
  // null = never checked. VERIFIED | NEEDS_REVIEW | LIKELY_INCORRECT otherwise.
  // Nothing in the verification pass may write any other Card column: it flags,
  // it never corrects. See src/lib/verification/verify.ts.
  verificationStatus String?
  verificationNotes  String?
  verifiedAt         DateTime?

  sales          Sale[]
  priceComps     PriceComp[]
  priceSnapshots PriceSnapshot[]

  @@unique([storeId, qrCode])
  @@index([storeId, category, status])
  // Backs the "show me only flagged cards" filter, which is the whole point of
  // running the audit — after a 500-row import nobody scrolls the full list.
  @@index([storeId, verificationStatus])
  @@index([storeId, name])
  @@index([importBatchId])
}

model Category {
  id          String  @id @default(cuid())
  storeId     String
  store       Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  key         String // "NBA", "Pokemon", etc. — unique within a store, not globally
  displayName String
  icon        String? // for the tab/sidebar UI
  sortOrder   Int     @default(0)
  fieldSchema Json // defines which attribute fields this category shows on its Add/Edit form
  themeTokens Json // e.g. { "accent": "#F97316", "accentDark": "#C2410C", "surface": "#1C1917" }
  isBuiltIn   Boolean @default(false)

  @@unique([storeId, key])
  @@index([storeId])
}

model Sale {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cardId        String
  card          Card     @relation(fields: [cardId], references: [id])
  // Audit trail: which member rang this sale up. Nullable so sales recorded before
  // the user system existed (and any future automated entry) remain valid.
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  soldPrice     Float
  quantitySold  Int      @default(1)
  paymentMethod String
  timestamp     DateTime @default(now())
  buyerContact  String?
  bundleId      String?
  bundle        Bundle?  @relation(fields: [bundleId], references: [id])

  @@index([storeId, timestamp])
  @@index([cardId])
}

model Bundle {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  timestamp     DateTime @default(now())
  totalPrice    Float
  paymentMethod String
  buyerContact  String?
  sales         Sale[]

  @@index([storeId])
}

model PriceComp {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cardId    String
  card      Card     @relation(fields: [cardId], references: [id])
  source    String // "eBay", "manual", "130point", "TCGplayer", "PriceCharting"
  price     Float
  url       String?
  fetchedAt DateTime @default(now())

  @@index([cardId])
  @@index([storeId])
}

/// One aggregated reading of what a card was selling for, captured per comp
/// refresh and never rewritten.
///
/// `PriceComp` holds the *current* listings and is wiped and refilled on every
/// refresh, so it can never express change over time — the old "Price History"
/// chart was really plotting ten concurrent listings in insertion order. This
/// table stores one row per refresh instead, so a trend line means something.
model PriceSnapshot {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  source      String // "eBay (auto)", or a manual source
  medianPrice Float
  minPrice    Float
  maxPrice    Float
  sampleSize  Int
  capturedAt  DateTime @default(now())

  @@index([cardId, capturedAt])
  @@index([storeId])
}

model FilterPreset {
  id         String  @id @default(cuid())
  storeId    String
  store      Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  category   String? // null = applies across "All categories"
  filterJson Json
  createdAt  DateTime @default(now())

  @@index([storeId])
}

/// Per-store preferences. One row per store — the old single-install "singleton"
/// row is gone now that several stores share the database.
model Settings {
  id                    String    @id @default(cuid())
  storeId               String    @unique
  store                 Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  minMarginPct          Float     @default(20)
  usdExchangeRate       Float?
  exchangeRateFetchedAt DateTime?
}

/// One worksheet upload. Drives the post-commit enrichment progress indicator
/// and doubles as the import history log.
model ImportBatch {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fileName      String
  createdAt     DateTime @default(now())
  rowCount      Int
  importedCount Int      @default(0)
  /// Rows that matched an existing card and changed its quantity/price rather
  /// than creating a new one. Split out from importedCount so the history log can
  /// answer "did this import add stock, or just re-price it?".
  updatedCount  Int      @default(0)
  skippedCount  Int      @default(0)
  enrichedCount Int      @default(0)
  /// Post-import verification outcome, so the completion summary can report it.
  verifiedCount Int      @default(0)
  flaggedCount  Int      @default(0)
  reviewCount   Int      @default(0)
  failedCount   Int      @default(0)
  status        String   @default("importing") // importing | enriching | complete
  finishedAt    DateTime?

  cards Card[]

  @@index([storeId, createdAt])
}

/// A saved column mapping for one seller's spreadsheet layout.
///
/// Every store's sheet has its own header names and order, so the importer maps
/// them per upload. Saving that decision means the second upload from the same
/// source arrives pre-mapped — matched on `headerSignature`, the sheet's sorted
/// normalised headers, which is stable against column reordering but changes if
/// the source genuinely adds or renames a column.
model ImportMapping {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name            String
  headerSignature String
  /// { appFieldKey: worksheetHeader } — absent key means "not mapped".
  fieldMap        Json
  /// { rawCategoryValueLowercased: categoryKey }
  categoryMap     Json
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime @default(now())

  @@unique([storeId, name])
  @@index([storeId, lastUsedAt])
}

/// Enrichment lookups keyed by category+name+series so a re-import of similar cards
/// doesn't re-spend the 100 req/day free-tier quota on the same players.
///
/// Deliberately NOT per-store: this caches public player statistics, so sharing it
/// across stores is both correct and the thing that keeps the shared API quota
/// survivable. It holds no store's private data.
model EnrichmentCache {
  key       String   @id
  provider  String
  payload   Json?
  hit       Boolean  @default(true) // false = looked up, genuinely no match; still worth caching
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

/// An account. Every user belongs to exactly one store: signing up creates a new
/// store with that user as OWNER, and an OWNER can add MEMBERs to their own store.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role         String   @default("MEMBER") // "OWNER" | "MEMBER"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales Sale[]

  @@index([storeId, role])
}
